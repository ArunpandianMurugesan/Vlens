{
  "name": "vlens-desktop",
  "productName": "Vlens",
  "version": "1.1.0",
  "description": "Vlens as a Mac app.",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "app": "LENS_DEV_URL=http://127.0.0.1:3467 electron .",
    "prepare-server": "node scripts/prepare-server.mjs",
    "dist": "npm run prepare-server && electron-builder --mac --publish never && rm -rf dist/mac-arm64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.arunpandianmurugesan.vlens",
    "productName": "Vlens",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.cjs", "package.json"],
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      { "from": "../lens-plugin", "to": "lens-plugin", "filter": ["**/*"] }
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }, { "target": "dir", "arch": ["arm64"] }],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null
    },
    "dmg": { "title": "Vlens" }
  }
}
